OPENALEX_EMAIL=team@example.com
# Free key from https://openalex.org/settings/api (recommended for production)
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=team@example.com
# Semantic Scholar: https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=
# LLM（OpenAI 兼容网关均可：OpenAI / OpenRouter / MiniMax Token Plan …）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# MiniMax Token Plan 示例（国内站用 api.minimaxi.com；国际站用 api.minimax.io）：
# OPENAI_API_KEY=你的_Minimax_Subscription_Key
# OPENAI_BASE_URL=https://api.minimaxi.com/v1
# OPENAI_MODEL=MiniMax-M3
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
CURSOR_WORKSPACE=.
MINERU_API_URL=
GROBID_BASE_URL=http://localhost:8070
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
MP_API_KEY=

# Optional: Sciverse / 穹宇 (https://sciverse.space → console Bearer Token)
SCIVERSE_API_TOKEN=
# Legacy alias also accepted by the client:
SCIVERSE_API_KEY=
SCIVERSE_BASE_URL=https://api.sciverse.space
