# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env
.env.*
!**/.env.example

# Data & large artifacts (keep local; do not push competition-restricted data)
**/data/raw/
**/data/processed/
**/data/fulltext/
**/data/qdrant/
**/data/models/
**/data/scibase/
# Ignore materials_agent data dumps, but keep the offline demo fixture tracked for CI.
tracks/algorithm/materials_agent/data/**
!tracks/algorithm/materials_agent/data/
!tracks/algorithm/materials_agent/data/.gitkeep
!tracks/algorithm/materials_agent/data/local_papers.json
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.npz
*.npy
*.npz
*.parquet
*.csv.gz
prediction.csv
*.traj
*.xtc
*.dcd

# Experiments / logs / run outputs
**/experiments/**/runs/
**/logs/**
!**/logs/.gitkeep
mlruns/
wandb/
outputs/
**/outputs/
*.log

# Submission zip binaries (regenerate locally)
submissions/packages/*.zip
submissions/packages/_stage_*/
document/_pdf*_extract.txt

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# SpecStory / local tooling
.specstory/
.cursor/
